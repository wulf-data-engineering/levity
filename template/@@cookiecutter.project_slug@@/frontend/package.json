{
	"name": "frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/inject-splash-into-fallback.mjs",
		"preview": "vite preview",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig tsconfig.json",
		"check:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig tsconfig.json --watch",
		"format": "prettier --write .",
		"check-format": "prettier --check .",
		"lint": "eslint .",
		"test:unit": "vitest run",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"gen:proto": "node scripts/generate-protobuf-files.mjs"
	},
	"supportedArchitectures": {
		"os": [
			"darwin",
			"linux"
		],
		"cpu": [
			"x64",
			"arm64"
		]
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^9.37.0",
		"@inlang/paraglide-js": "^2.29.2",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.62.0",
		"@playwright/test": "^1.64.1",
		"@storybook/addon-docs": "^10.6.4",
		"@storybook/addon-svelte-csf": "^5.1.5",
		"@storybook/sveltekit": "^10.6.4",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.5",
		"@types/snappyjs": "^0.7.1",
		"@vitest/browser": "^5.0.5",
		"axe-playwright": "^2.2.2",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"dotenv": "^18.0.9",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.63.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-sonner": "^1.2.2",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.1.13",
		"ts-proto": "^2.18.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.1",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@aws-amplify/auth": "^6.21.2",
		"amazon-cognito-identity-js": "^6.3.22",
		"aws-amplify": "^6.22.2",
		"snappyjs": "^0.7.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"postcss-selector-parser": "^6.1.5"
	}
}
