{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"composite": true,
		"target": "es2020",
		"lib": ["es2020", "DOM", "DOM.Iterable"],
		"strict": true,
		"checkJs": false,
		"skipLibCheck": true,
		"types": ["$app/types", "node", "svelte", "playwright", "@testing-library/jest-dom"]
	},

	"references": [
		{
			"path": "./tsconfig.config.json"
		},
		{
			"path": "./tsconfig.e2e.json"
		}
	],
	"include": ["src", "scripts", "vite.config.ts", "playwright.config.js"]
}
